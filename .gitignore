*.iml
.kotlin
.gradle
**/build/
xcuserdata
!src/**/build/
local.properties
# Secretos/credenciales inyectados en build (Client IDs de Google, etc.). No se
# versionan (CLAUDE.md §7); usar `secrets.properties.example` como plantilla.
secrets.properties
# Firma de release: el keystore y sus contraseñas. Perder el keystore impide volver a
# actualizar la app en Play, así que guárdalo aparte y con copia de seguridad.
keystore.properties
*.jks
*.keystore
.idea
.DS_Store
captures
.externalNativeBuild
.cxx
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
node_modules/

# Artefactos de salida de release (AAB/APK firmados). Los regenera Gradle en cada
# build; versionarlos deja blobs de decenas de MB en el historial que ya no se
# pueden quitar sin reescribirlo.
androidApp/release/
*.aab

# Caché del CLI de Supabase (comprobación de versión). Se regenera sola.
supabase/.temp/
