# Plantilla de la firma de RELEASE de Android.
#
# CÓMO USAR:
#   1. Copia este archivo a `keystore.properties` (en la raíz del repo):
#        cp keystore.properties.example keystore.properties
#   2. Rellena los cuatro valores con los que usaste al crear el keystore.
#   3. `keystore.properties` y `*.jks` están en .gitignore: NO se commitean.
#
# A diferencia de `secrets.properties`, esto SÍ son secretos criptográficos de
# verdad: quien tenga el .jks y estas contraseñas puede firmar actualizaciones
# haciéndose pasar por ti. No los pegues en chats, issues ni capturas.
#
# Si falta el archivo, o algún valor queda vacío, o `storeFile` no existe, el
# build NO falla: firma el release con la clave de debug y avisa por consola. Eso
# permite instalar y probar un release en un dispositivo, pero Play rechaza esa
# build, así que no puede colarse a producción por descuido.

# Ruta al keystore. Absoluta, o relativa al módulo `androidApp/`.
# Si el .jks está en la raíz del repo, la ruta relativa correcta es `../nombre.jks`.
storeFile=../kortexgames-upload.jks

# Contraseña del almacén (la primera que pidió keytool).
storePassword=

# Alias de la clave (el `-alias` del comando keytool; por defecto `upload`).
keyAlias=upload

# Contraseña de la clave. Si al crear el keystore pulsaste INTRO para reutilizar
# la del almacén, es la misma que `storePassword`.
keyPassword=
