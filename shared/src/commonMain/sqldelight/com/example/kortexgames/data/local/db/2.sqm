-- Migración v2 → v3: añade la tabla de estado por-usuario de logros. Necesaria para
-- que las instalaciones EXISTENTES (BD en v2, con PlayerGameProgressEntity pero sin
-- esta tabla) la reciban vía onUpgrade. Las instalaciones nuevas la obtienen del
-- CREATE en Achievements.sq mediante Schema.create. Este .sqm eleva Schema.version a
-- 3, disparando la migración en dispositivos con la BD antigua. Mismo patrón que
-- 1.sqm (ver PlayerProgress.sq); toda nueva alta de tabla/columna debe seguirlo.
CREATE TABLE UserAchievementEntity (
    achievementId TEXT    NOT NULL PRIMARY KEY,
    progress      INTEGER NOT NULL,
    unlockedAt    INTEGER,
    isSynced      INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_user_ach_synced ON UserAchievementEntity(isSynced);
