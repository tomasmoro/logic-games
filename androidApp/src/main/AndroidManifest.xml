<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Notificaciones (recordatorios de racha, misión diaria y récords). Desde
         Android 13 es permiso de ejecución: se pide desde el interruptor de Ajustes,
         nunca al arrancar (ver NotificationScheduler). No se declara
         SCHEDULE_EXACT_ALARM a propósito: los recordatorios usan alarmas inexactas,
         que no requieren permiso ni justificación ante Google Play. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LogicGamesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KortexGames">

        <!-- AdMob App ID (lo exige el SDK; sin él, MobileAds.initialize crashea).
             El valor lo inyecta el placeholder `admobAppId` de build.gradle.kts:
             por defecto el App ID de PRUEBA de Google, el real desde secrets.properties. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Bloqueo de orientación en pantallas grandes: desde Android 16 (targetSdk 36)
             el sistema IGNORA android:screenOrientation en displays de ancho >= 600dp
             (tablets, plegables abiertos). Esta propiedad reactiva el respeto por la
             orientación fija que declara la Activity. Google la marca como transitoria
             (deja de funcionar con targetSdk 37): si algún día se sube el target, habrá
             que rediseñar los tableros para landscape en vez de prohibirlo. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <!-- screenOrientation: los tableros (rejillas, crucigrama, teclados) están
             dimensionados para vertical; en horizontal quedarían aplastados. Se fija
             portrait "normal" (sin boca abajo, que en un móvil solo desorienta). -->
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receptor de las alarmas de notificación. La clase vive en `shared`
             (androidMain), pero todo componente de Android debe declararse en el
             manifest de la APLICACIÓN para que el sistema pueda instanciarlo.
             exported=false: solo lo despierta el AlarmManager con nuestro propio
             PendingIntent, ninguna otra app tiene por qué poder dispararlo. -->
        <receiver
            android:name="com.kortexgames.app.core.notifications.NotificationAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>